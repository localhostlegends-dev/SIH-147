      "id": "automatic",
      "label": "Automatic analysis",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "results",
      "label": "Read and hand over",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "groups": [
    {
      "id": "manual_path",
      "label": "Only when the automatic guess looks wrong",
