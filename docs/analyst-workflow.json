          "analyse",
          "decode",
          "review"
        ],
        "note": "Everything between the file and the decoded message is automatic."
      },
      {
        "id": "analyst-help",
        "label": "When the analyst steps in",
        "focus": [
          "analyse",
          "override",
          "decode",
          "blind"
        ],
        "note": "Any stage can be forced by hand when the automatic guess looks wrong."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "Analyst screen"
        },
        "backend": {
          "label": "Automatic stage"
        },
        "security": {
          "label": "Manual override"
        },
        "messagebus": {
          "label": "Fallback mode"
        },
        "external": {
          "label": "Starting point"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "analyst",
      "label": "Analyst"
    },
    {
      "id": "engine",
      "label": "Analysis engine (automatic)"
