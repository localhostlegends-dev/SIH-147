  "cards": [
    {
      "dot": "cyan",
      "title": "Receiver chain",
      "items": [
        "Sampling rate from the WAV header, the file name or the analyst",
        "Symbol rate from the cyclic spectral line; modulation from higher-order statistics or tone clustering",
        "Matched filter, timing recovery and carrier recovery produce soft bits"
      ]
    },
    {
      "dot": "emerald",
      "title": "Blind decoding",
      "items": [
        "Frames found by preamble correlation, or blindly from period and bit constancy",
        "Every interleaver shape and seed scored against every candidate code",
        "The winner de-interleaves and decodes all frames; sync-word correlation splits header from payload"
      ]
    },
    {
      "dot": "rose",
      "title": "Interfaces and proof",
      "items": [
        "Streamlit GUI for interactive analysis, command line for batch runs",
        "Fully offline on a laptop: no GPU, no internet, no licence",
        "The generator writes recordings with known settings, so every stage can be proven"
      ]
    }
  ]
